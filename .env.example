# Copy to a local untracked environment file. Never commit real values.
# Use the exact browser origin. localhost and 127.0.0.1 are different origins.
BETTER_AUTH_URL=http://127.0.0.1:3100
# Generate a long random secret in a secret manager. Minimum 32 characters.
# This key also encrypts MFA/session/outbox data; preserve it with DB backups.
BETTER_AUTH_SECRET=

# Production/serverless requires durable PostgreSQL, preferably its pooled URL.
DATABASE_URL=
# Local development only; ignored when DATABASE_URL is configured.
ACCOUNT_DB_PATH=data/accounts.sqlite

# Set only after publishing approved policies matching POLICY_VERSION in auth.mjs.
POLICY_APPROVED_VERSION=

# Resend with a verified sending domain; e.g. SportsLab <accounts@your-domain>.
RESEND_API_KEY=
EMAIL_FROM=

# Configure signed webhook at BETTER_AUTH_URL/api/billing/webhook.
# Never use production credentials for local automated tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Provider Price IDs remain keyed by legacy IDs; see docs/pricing-plans.md.
# Basic display ($14.99/month) uses the existing premium ID and variables.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Pro display ($24.99/month): reserved premium_plus mapping; checkout disabled.
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=
STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=
# Premium display ($49.99/month) uses the existing pro ID and variables.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Premium Max ($99.99/month) is display-only; no billing ID, grants or env mapping.
# Annual pricing is not approved by these monthly amounts. Do not infer a discount.

# Shared secret for existing prediction crons and /api/cron/accounts.
CRON_SECRET=
# Existing analytics integrations; configure only as required for those services.
PUBLIC_SITE_URL=http://127.0.0.1:3100
# Leave blank until you have a help subdomain attached to this deployment.
# Example: help.your-domain.example (hostname only). See docs/help-center.md.
# Its links return to the canonical main app origin in PUBLIC_SITE_URL.
HELP_CENTER_HOST=
BLOB_READ_WRITE_TOKEN=
# Your odds/quote API. Any origin without a path: a local or private-network server
# (http://192.168.1.20:8000), or a public IP or domain, which must use HTTPS
# (https://api.example.com). Requests carry EV_TOOL_API_KEY in the X-API-Key header.
EV_TOOL_API_URL=
EV_TOOL_API_KEY=
# Set to 1 only to accept plain HTTP to a public IP; the API key would be sent unencrypted.
EV_TOOL_API_ALLOW_HTTP=
# Second quote source: VPS harvester at /all?format=txt (lib/odds/vpsodds.mjs). On by default when
# an origin is reachable; VPS_ODDS_ENABLED=0 turns it off.
VPS_ODDS_URL=http://209.145.53.103:3456
VPS_ODDS_ENABLED=
PORT=3100
AUTO_SYNC=0

# Google sign-in (optional). Authorized redirect URI in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Privacy-friendly analytics (optional). Loaded only after a visitor accepts in the consent banner.
# e.g. ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=visualodds.com

# Community link shown in the site footer when set (https only), e.g. a Discord invite.
COMMUNITY_URL=
